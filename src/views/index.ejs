<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>LogiTrack</title>
</head>
<%- include('partials/header') %>
<body>
    <main class="main-content">
        <div class="page-header">
            <div class="top-main">
                <h1>Panel General</h1>
            </div>
            <div class="dates-shipment">
                <div class="boxes">
                    <div class="shipment-active">
                        <span>Envios Activos</span>
                        <span>145</span>
                        <span class="material-symbols-outlined">local_shipping</span>
                    </div>
                    <div class="shipment-complete">
                        <span>Entregas Hoy</span>
                        <span>145</span>
                        <span class="material-symbols-outlined">box</span>
                    </div>
                     <div class="shipment-demored">
                        <span>En Sucursal</span>
                        <span>145</span>
                        <span class="material-symbols-outlined">apartment</span>
                    </div>
                     <div class="shipment-new">
                        <span>Envios Nuevos</span>
                        <span>145</span>
                        <span class="material-symbols-outlined">add</span>
                    </div>
                </div>
            </div>
            <div class="access">
                <div class="new-shipment">
                        <a href="/shipments/new" class="btn-primary">
                            <span class="material-symbols-outlined">add_circle</span>Crear nuevo envio
                        </a>
                </div>
                <div class="search-shipment">
                    <a href="/shipments" class="btn-primary">
                        <span class="material-symbols-outlined">search</span>Buscar envio por ID/DNI
                    </a>
                </div>
            </div>
            <div class="last-activities">
                <table>
                    <thead>
                        <tr>
                            <th>ID Tracking</th>
                            <th>Destinatario</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                             <% if (shipments.length === 0) { %>
                                <td></td>
                                <td></td>
                             <% } %>
                        </tr>
                 
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
<footer>
</footer>
<script src="/js/theme.js" defer></script>
<script src="/js/ui.js" defer></script>
</html>
