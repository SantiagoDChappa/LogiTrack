<header>
    <div class="left-header">
        <div class="logo">
            <img src="/images/logo.png" alt="LogiTrack logo">
            <h1>LogiTrack</h1>
        </div>
        <div class="arbol">
            <li>
                <a href="/dashboard"><ul><span class="material-symbols-outlined">dashboard</span>Dashboard</ul></a>
                <a href="/envios/administrador"><ul><span class="material-symbols-outlined">local_shipping</span>Envios</ul></a>
                <a href="/clientes/administrador"><ul><span class="material-symbols-outlined">person</span>Clientes</ul></a>
                <a href="/reportes"><ul><span class="material-symbols-outlined">bar_chart</span>Reportes</ul></a>
                <a href="/ajustes"><ul><span class="material-symbols-outlined">settings</span>Ajustes</ul></a>
            </li>
        </div>
        <div class="theme-mode">
            <button id="btn-theme" aria-label="Cambiar tema">
                <span class="material-symbols-outlined" id="theme-icon">light_mode</span>
                <span id="theme-label">Modo oscuro</span>
            </button>
        </div>
    </div>
    <div class="top-header">
        <form action="" method="get">
            <input type="text" name="buscador" id="" placeholder="Buscar envio por ID, DNI de destinatario, etc...">
        </form>
        <i><span class="material-symbols-outlined">notifications</span></i>
        <div class="user">
            <img src="/images/user.png" alt="">
            <span class="user-name">Santiago Chappa</span>
            <span class="user-role">Operador</span>
            <span class="material-symbols-outlined">keyboard_arrow_down</span>
        </div>
        <div class="user-btn" id="user-dropdown">
            <li>
                <ul><span class="material-symbols-outlined">manage_accounts</span>Configurar perfil</ul>
                <div class="dropdown-divider"></div>
                <ul class="danger"><span class="material-symbols-outlined">logout</span>Cerrar sesión</ul>
            </li>
        </div>
    </div>
</header>
