<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <title>Nuevo Envío - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
     <main class="main-content">
        <div class="page-header">
            <h1>Alta de envio</h1>
        </div>
        <div class="form-new">
            <form action="" method="post">
                <div class="remitente">
                    <h3>Remitente</h3>
                    <div class="field">
                        <label for="remitente-nombre">Nombre y Apellido</label>
                        <input id="remitente-nombre" type="text" name="remitente_nombre" value="<%= body.remitente_nombre || '' %>">
                    </div>
                     <div class="field">
                        <label for="remitente-documento">Documento</label>
                        <input id="remitente-documento" type="text" name="remitente_documento" value="<%= body.remitente_documento || '' %>">
                    </div>
                    <div class="field">
                        <label for="remitente-telefono">Teléfono</label>
                        <input id="remitente-telefono" type="tel" name="remitente_telefono"  maxlength="10" value="<%= body.remitente_telefono || '' %>">
                    </div>
                    <div class="field">
                        <label for="remitente-email">Email</label>
                        <input id="remitente-email" type="email" name="remitente_email" value="<%= body.remitente_email || '' %>">
                    </div>
                </div>

                <div class="destinatario">
                    <h3>Destinatario</h3>
                    <div class="field">
                        <label for="destinatario-nombre">Nombre y Apellido</label>
                        <input id="destinatario-nombre" type="text" name="destinatario_nombre" value="<%= body.destinatario_nombre || '' %>">
                    </div>
                    <div class="field">
                        <label for="destinatario-documento">Documento</label>
                        <input id="destinatario-documento" type="text" name="destinatario_documento" value="<%= body.destinatario_documento || '' %>">
                    </div>
                    <div class="field">
                        <label for="destinatario-telefono">Teléfono</label>
                        <input id="destinatario-telefono" type="tel" name="destinatario_telefono" maxlength="10" value="<%= body.destinatario_telefono || '' %>">
                    </div>
                    <div class="field">
                        <label for="destinatario-email">Email</label>
                        <input id="destinatario-email" type="email" name="destinatario_email" value="<%= body.destinatario_email || '' %>">
                    </div>
                </div>

                <div class="direccion">
                    <h3>Dirección de entrega</h3>
                    <div class="field">
                        <label for="calle">Calle</label>
                        <input id="calle" type="text" name="calle" value="<%= body.calle || '' %>">
                    </div>
                    <div class="field">
                        <label for="numero">Número</label>
                        <input id="numero" type="number" name="numero" value="<%= body.numero || '' %>">
                    </div>
                    <div class="field">
                        <label for="piso">Piso y/o Depto</label>
                        <input id="piso" type="text" name="piso_depto" value="<%= body.piso_depto || '' %>">
                    </div>
                    <div class="field">
                        <label for="provincia">Provincia</label>
                        <select id="provincia" name="provincia">
                            <option value="">Seleccione una provincia</option>
                            <% provinces.forEach(prov => { %>
                                <option value="<%= prov %>" <%= body.provincia === prov ? 'selected' : '' %>><%= prov %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field">
                        <label for="codigo_postal">Código Postal</label>
                        <input id="codigo_postal" type="number" name="codigo_postal" value="<%= body.codigo_postal || '' %>">
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/shipments" class="btn-secondary">Cancelar</a>
                    <button type="submit" class="btn-primary">Guardar envío</button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
