<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <title>Detalle de Envío - LogiTrack</title>
</head>

<body>
    <%- include('../partials/header') %>

    <main class="main-content">
        <div class="page-header">
            <h1>Detalle de Envío</h1>
            <a href="/shipments" class="btn-secondary">Volver</a>
        </div>
        <div class="detail-wrapper">

            <div class="detail-top">
                <div class="detail-tracking">
                    <span class="detail-tracking-label">ID Tracking</span>
                    <span class="detail-tracking-id"><%= shipment.id %></span>
                </div>
                <span class="status-badge <%= shipment.estado.toLowerCase().replace(' ', '-') %>">
                    <%= shipment.estado %>
                </span>
            </div>

            <div class="detail-cards">
                <div class="detail-card">
                    <h3>Remitente</h3>
                    <div class="detail-field">
                        <span class="detail-label">Nombre y apellido</span>
                        <span class="detail-value"><%= shipment.remitente.nombre %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Documento</span>
                        <span class="detail-value"><%= shipment.remitente.documento %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Teléfono</span>
                        <span class="detail-value"><%= shipment.remitente.telefono %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value"><%= shipment.remitente.email %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <h3>Destinatario</h3>
                    <div class="detail-field">
                        <span class="detail-label">Nombre y apellido</span>
                        <span class="detail-value"><%= shipment.destinatario.nombre %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Documento</span>
                        <span class="detail-value"><%= shipment.destinatario.documento %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Teléfono</span>
                        <span class="detail-value"><%= shipment.destinatario.telefono %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value"><%= shipment.destinatario.email %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <h3>Dirección de entrega</h3>
                    <div class="detail-field">
                        <span class="detail-label">Calle y número</span>
                        <span class="detail-value"><%= shipment.direccion.calle %> <%= shipment.direccion.numero %><%= shipment.direccion.piso_depto ? ', ' + shipment.direccion.piso_depto : '' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Provincia</span>
                        <span class="detail-value"><%= shipment.direccion.provincia %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Código postal</span>
                        <span class="detail-value"><%= shipment.direccion.codigo_postal %></span>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>